# Existing .env supplies NFC_SERIAL_PORT and NFC_STATION_KEY.
STATION_DASHBOARD_URL=http://10.145.8.144:8001
STATION_UR_HOST=ur10_r
STATION_RUNNING_VARIABLE=Laeuft
STATION_TIME_VARIABLE=Zeit
STATION_WINNER_VARIABLE=Gewinner
STATION_TIME_UNIT=seconds

# Boolean signal: true = child won, false = child lost.
STATION_WINNER_MAP='{"true":"win","false":"loss"}'

# The speed slider (targetSpeedFraction) determines one of ten levels at game start.
STATION_DIFFICULTY_SOURCE=override
# Optional alternatives: source=variable or source=fixed.
STATION_DIFFICULTY_VARIABLE=
STATION_DIFFICULTY_MAP='{}'
STATION_FIXED_DIFFICULTY=

# STATION_DB=/absolute/path/station.sqlite3
